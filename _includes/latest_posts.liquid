<div class="home-post-list">
  {% if site.latest_posts != blank %}
    {% assign latest_posts_size = site.posts | size %}
    {% assign latest_posts = site.posts %}
    {% if site.latest_posts.limit %}
      {% assign latest_posts_limit = site.latest_posts.limit %}
    {% else %}
      {% assign latest_posts_limit = latest_posts_size %}
    {% endif %}

    {% for item in latest_posts limit: latest_posts_limit %}
      {% if item.external_source == blank %}
        {% assign read_time = item.content | number_of_words | divided_by: 180 | plus: 1 %}
      {% else %}
        {% assign read_time = item.feed_content | strip_html | number_of_words | divided_by: 180 | plus: 1 %}
      {% endif %}

      {% if item.redirect == blank %}
        {% assign post_url = item.url | relative_url %}
      {% elsif item.redirect contains '://' %}
        {% assign post_url = item.redirect %}
      {% else %}
        {% assign post_url = item.redirect | relative_url %}
      {% endif %}

      <a
        class="home-post-card"
        href="{{ post_url }}"
        {% if item.redirect contains '://' %}
          target="_blank"
          rel="noopener noreferrer"
        {% endif %}
      >
        {% if item.thumbnail %}
          <span class="home-post-card__media">
            <img
              src="{{ item.thumbnail | relative_url }}"
              alt="{{ item.image_alt | default: item.title | escape }}"
              loading="lazy"
              decoding="async"
            >
          </span>
        {% endif %}
        <span class="home-post-card__body">
          <span class="home-post-card__meta">{{ item.date | date: '%b %d, %Y' }} · {{ read_time }} min read</span>
          <span class="home-post-card__title">{{ item.title }}</span>
          {% if item.description %}
            <span class="home-post-card__description">{{ item.description }}</span>
          {% endif %}
        </span>
      </a>
    {% endfor %}
  {% else %}
    <p>No posts so far...</p>
  {% endif %}
</div>
