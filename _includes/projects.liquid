<div
  class="col{% unless include.home %} reveal-on-scroll{% endunless %}"
  {% if include.home %}
    role="listitem"
  {% endif %}
>
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable">
      {% if project.img %}
        {% assign project_media_extension = project.img | split: '.' | last | downcase %}
        {% if project_media_extension == 'mp4' or project_media_extension == 'webm' or project_media_extension == 'ogg' %}
          {%
            include video.liquid
            path=project.img
            mp4_path=project.mp4
            poster=project.poster
            autoplay=true
            loop=true
            muted=true
            playsinline=true
            preload="metadata"
            alt="project thumbnail"
            class="card-img-top"
          %}
        {% else %}
          {%
            include figure.liquid
            loading="eager"
            path=project.img
            sizes = "250px"
            alt="project thumbnail"
            class="card-img-top"
          %}
        {% endif %}
      {% endif %}
      <div class="card-body">
        <h2
          class="card-title"
          {% if include.home %}
            title="{{ project.title | escape }}"
          {% endif %}
        >
          {{ project.title }}
        </h2>
        <p class="card-text">{{ project.description }}</p>
        {% if project.skills %}
          <ul class="project-skills" aria-label="Tools and skills used">
            {% for skill in project.skills %}
              <li>{{ skill }}</li>
            {% endfor %}
          </ul>
        {% endif %}
        <div class="row ml-1 mr-1 p-0">
          {% if project.github %}
            <div class="github-icon">
              <div class="icon" data-toggle="tooltip" title="Code Repository">
                <a href="{{ project.github }}"><i class="fa-brands fa-github gh-icon"></i></a>
              </div>
              {% if project.github_stars %}
                <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                  <i class="fa-solid fa-star"></i>
                  <span id="{{ project.github_stars }}-stars"></span>
                </span>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </a>
</div>
